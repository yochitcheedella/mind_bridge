# MIND-BRIDGE VIT ENVIRONMENT VARIABLES — TEMPLATE
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# 1. Database Setup
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 2. Security
SECRET_KEY=your-64-char-random-secret-key-here
ENVIRONMENT=production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. CORS & Origins
CORS_ORIGINS=https://your-frontend.vercel.app

# 4. AI Engine Integrations (optional — AI features disabled if not set)
OPENAI_API_KEY=
GEMINI_API_KEY=

# 5. Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 6. Frontend API Config (for native mobile APK / PWA builds)
VITE_API_URL=https://your-backend.onrender.com
VITE_WS_URL=wss://your-backend.onrender.com

# 7. Firebase Cloud Messaging (optional — push notifications)
FIREBASE_CREDENTIALS_JSON=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
