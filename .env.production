# MIND-BRIDGE PRODUCTION ENVIRONMENT VARIABLES TEMPLATE

# 1. Database Setup
# Must point to the internal Kubernetes service name or external managed DB (e.g. AWS RDS)
DATABASE_URL=postgresql://mindbridge:mindbridge_secret@postgres:5432/mindbridgedb

# 2. Security
# Replace with a strong, 32+ character random string in production
SECRET_KEY=your_super_secret_production_key_here
# Set to 'production' to enforce strict secure cookies and logging
ENVIRONMENT=production

# 3. CORS
# Comma-separated list of allowed origins (your production domains)
CORS_ORIGINS=https://app.mindbridge.com,https://admin.mindbridge.com

# 4. Third-Party Integrations
OPENAI_API_KEY=sk-your-openai-key-here
# SUPABASE_URL=https://your-supabase.supabase.co
# SUPABASE_KEY=your-supabase-key
